# Contact form (api/contact.ts). Set these in Vercel → Project → Settings → Environment Variables.

# Resend API key (https://resend.com → API Keys)
RESEND_API_KEY=

# Inbox(es) that receive form submissions, comma-separated.
# Until you verify a domain in Resend, this must be the email you signed up to Resend with.
CONTACT_TO=novarchin@gmail.com

# Optional: sender address on a domain you've verified in Resend.
# Leave empty to use Resend's test sender (onboarding@resend.dev).
CONTACT_FROM=
